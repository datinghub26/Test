<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive hidden files & directories (.env, .git, etc.)
    RewriteRule ^\.(.*)$ - [F,L]

    # Prevent access to configuration, test, and container files
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|Dockerfile|\.dockerignore|phpunit\.xml|vite\.config\.js|postcss\.config\.js)$ - [F,L]

    # Protect internal application directories from public listing
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests)/ - [F,L]

    # Route all traffic directly to public/ folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>